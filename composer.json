{
    "name": "plastani/app",
    "description": "Plastani Laravel application",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.48.0",
        "laravel/pail": "^1.2",
        "nunomaduro/collision": "7.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5",
        "laravel/sail": "^1.65",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
